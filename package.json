{
  "name": "poembooth-kiosk",
  "version": "1.5.10",
  "description": "Poem Booth Kiosk Application - AI-powered photo booth for generating personalized poems",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:mock-printer": "electron . --dev --mock-printer",
    "dev:real-printer": "electron . --dev --real-printer",
    "dev:staging": "electron . --dev --staging",
    "dev:staging-printer": "electron . --dev --staging --real-printer",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "release": "node scripts/release.js",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "kiosk",
    "photo-booth",
    "ai",
    "poems"
  ],
  "author": "Poem Booth",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "electron-updater": "^6.1.7",
    "koffi": "^3.0.2",
    "node-machine-id": "^1.1.12",
    "sharp": "^0.33.0"
  },
  "optionalDependencies": {
    "onoff": "^6.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/justusbruns/poemboothkiosk.git"
  },
  "build": {
    "appId": "com.poembooth.kiosk",
    "productName": "PoemBooth Kiosk",
    "artifactName": "${name}-${version}-${os}.${ext}",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "packElevateHelper": false,
      "allowElevation": false
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "src/services/dnpSupplyReader.js"
    ],
    "publish": {
      "provider": "github",
      "owner": "justusbruns",
      "repo": "poemboothkiosk"
    }
  },
  "allowScripts": {
    "electron@44.7.0": true,
    "koffi@3.0.2": true,
    "sharp@0.33.5": true,
    "@electron/rebuild@4.2.1": true
  }
}
